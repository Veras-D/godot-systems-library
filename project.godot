; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it can be edited easily using any text editor.

config_version=5

[application]

config/name="Godot Systems Library"
config/description="Universal, modular, decoupled game systems library for Godot 4."
config/version="1.0.0"
config/features=PackedStringArray("4.7", "Forward Plus")
run/main_scene="res://timing_wheel/testbed_wheel.tscn"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom="res://testbed_theme.tres"

[rendering]

renderer/rendering_method="forward_plus"
